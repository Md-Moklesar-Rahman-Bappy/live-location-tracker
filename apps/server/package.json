{
  "name": "@lts/server",
  "version": "1.0.0",
  "private": true,
  "description": "Live Location Tracker backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts --dir tests/unit",
    "test:integration": "vitest run --config vitest.config.ts --dir tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy --schema=../../prisma/schema.prisma",
    "db:seed": "tsx ../../prisma/seed.ts",
    "db:studio": "prisma studio --schema=../../prisma/schema.prisma",
    "cleanup": "tsx src/cleanup.ts"
  },
  "dependencies": {
    "argon2": "^0.31.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^8.1.0",
    "pino": "^9.4.0",
    "prisma": "^5.19.0",
    "rate-limiter-flexible": "^4.0.1",
    "socket.io": "^4.7.7",
    "uuid": "^14.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.11.0",
    "playwright": "^1.47.0",
    "prettier": "^3.3.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^5.0.4"
  }
}
