    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^8.3.4"
