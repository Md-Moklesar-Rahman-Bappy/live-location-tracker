# Live Location Tracker - Environment Configuration
# Copy this file to .env and fill in real values for local development.
# Never commit a real secret. .env is ignored by .gitignore.

# Node environment
NODE_ENV=development

# HTTP server
PORT=3000

# Application origins (comma-separated). Use exact origins, never wildcards.
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000

# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://livelocation:livelocation@localhost:5432/livelocation

# Server-side session signing secret (>= 32 bytes, random). Rotate periodically.
SESSION_SECRET=change-me-32-bytes-or-more-minimum

# Name of the session cookie
COOKIE_NAME=lts_session

# CORS allowlist (exact origins, comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Trust the first proxy hop (set to 1 behind Nginx/Caddy)
TRUST_PROXY=1

# Location data retention in hours (default 24)
LOCATION_RETENTION_HOURS=24

# Default share link expiration in minutes (default 60)
DEFAULT_SHARE_EXPIRY_MINUTES=60

# Maximum share link expiration in minutes (default 1440 = 24h)
MAX_SHARE_EXPIRY_MINUTES=1440

# Structured logging level (trace|debug|info|warn|error|fatal)
LOG_LEVEL=info

# Development seed toggle (only when NODE_ENV=development)
SEED_DEV_ACCOUNT=false

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Socket.IO
SOCKET_MAX_PAYLOAD_BYTES=65536

# Cleanup interval in minutes (expired sessions and location points)
CLEANUP_INTERVAL_MINUTES=30